{
  "manifest_version": 2,
  "name": "TempBox",
  "version": "1.1.0",
  "description": "Temporary email addresses that appear when you need",
  "browser_specific_settings": {
    "gecko": {
      "id": "tempbox@addon.local"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "alarms",
    "https://api.mail.tm/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.svg",
      "32": "icon.svg",
      "48": "icon.svg"
    }
  },
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "content_security_policy": "default-src 'self'; connect-src https://api.mail.tm; style-src 'self' 'unsafe-inline';"
}
